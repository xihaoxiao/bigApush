# ============================================
# 本地凭据配置（已 gitignore，【不要】提交到仓库）
# ============================================
# 复制本文件为 config/config.local.yaml 后填入你的凭据。
#
# 或者直接用环境变量 / GitHub Secrets（推荐，CI 用这个）：
#   FEISHU_WEBHOOK / SERVERCHAN_SENDKEY
#   SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_FROM / SMTP_TO
#   SMTP_USE_SSL / SMTP_USE_TLS
#
# 优先级：环境变量 > config.local.yaml > config.yaml > config.defaults.yaml
# ============================================

# 飞书机器人（群设置 → 添加自定义机器人 → 复制 Webhook 地址）
feishu:
  webhook_url: ""

# Server酱（https://sct.ftqq.com 获取 SendKey）
serverchan:
  sendkey: ""

# 邮箱推送（通用 SMTP：QQ/163/Gmail/Outlook 均可）
# 注意：QQ/163 的 password 要填"授权码"，不是登录密码
email:
  host: ""            # 例如 smtp.qq.com
  port: 465           # 465=SSL，587=STARTTLS，留空按 host 自动推断
  user: ""            # 登录账号（QQ 填完整邮箱地址）
  password: ""        # 授权码/密码
  from: ""            # 发件人地址，留空则用 user
  to: ""              # 收件人，多个用逗号分隔，留空则发给 user
  use_ssl: true       # 465 端口用 true，587 端口用 false
  use_tls: false
