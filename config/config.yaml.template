# ============================================
# A股量化选股系统 - 主配置文件模板
# ============================================
# 使用说明：
# 1. 复制此文件为 config.yaml
# 2. 填入推送渠道配置（飞书 / Server酱，填哪个就推哪个，都填则同时推送）
# 3. 不要提交 config.yaml 到Git仓库（已加入.gitignore）

data_dir: data

# 飞书机器人配置（可选，与 Server酱可同时使用）
# 在飞书群中添加自定义机器人，复制 webhook URL
feishu:
  webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK_HERE"

# Server酱配置（可选，与飞书可同时使用）
# 在 https://sct.ftqq.com 获取 SendKey（Server酱 Turbo / Server酱³ 均支持）
# 也可用环境变量 SERVERCHAN_SENDKEY 覆盖
serverchan:
  sendkey: ""

# 钉钉机器人配置（旧版，保留兼容）
# 1. 在钉钉群中添加自定义机器人
# 2. 复制 webhook URL 和加签密钥
# 3. 填入下方（去掉引号内的占位符）
dingtalk:
  webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE"
  secret: "YOUR_SECRET_HERE"

# 定时任务配置
schedule:
  time: "17:00"  # 每日执行时间

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true
