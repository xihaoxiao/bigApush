# ============================================
# A股量化选股系统 - 主配置文件模板（已废弃，请改用下面两个文件）
# ============================================
# 当前配置体系：
#   config/config.defaults.yaml       仓库内，非敏感配置（自动加载）
#   config/config.local.yaml          本地凭据（gitignore，模板见 config.local.yaml.example）
#   环境变量 / GitHub Secrets          最高优先级（CI 推荐）
#
# 加载顺序：defaults → config.yaml → local → 环境变量
# 由 utils/config_loader.py 统一处理。
#
# 本文件仅为兼容旧文档保留，复制它不会覆盖 defaults 的内容。

data_dir: data

# 飞书机器人配置（可选，与 Server酱可同时使用）
# 在飞书群中添加自定义机器人，复制 webhook URL
feishu:
  webhook_url: "https://open.feishu.cn/open-apis/bot/v2/hook/YOUR_WEBHOOK_HERE"

# Server酱配置（可选，与飞书/邮箱可同时使用）
# 在 https://sct.ftqq.com 获取 SendKey（Server酱 Turbo / Server酱³ 均支持）
# 也可用环境变量 SERVERCHAN_SENDKEY 覆盖
serverchan:
  sendkey: ""

# 邮箱推送配置（可选，与飞书/Server酱可同时使用）
# 通用 SMTP，QQ/163/Gmail/Outlook 均可
# 注意：QQ/163 邮箱的密码要填"授权码"而不是登录密码
# 也可用环境变量 SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASSWORD / SMTP_TO 覆盖
email:
  host: ""            # 例如 smtp.qq.com
  port: 465           # 465=SSL，587=STARTTLS，留空按 host 自动推断
  user: ""            # 登录账号（QQ 填完整邮箱地址）
  password: ""        # 授权码/密码
  from: ""            # 发件人地址，留空则用 user
  to: ""              # 收件人，多个用逗号分隔，留空则发给 user
  use_ssl: true       # 465 端口用 true，587 端口用 false
  use_tls: false

# 钉钉机器人配置（旧版，保留兼容）
# 1. 在钉钉群中添加自定义机器人
# 2. 复制 webhook URL 和加签密钥
# 3. 填入下方（去掉引号内的占位符）
dingtalk:
  webhook_url: "https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN_HERE"
  secret: "YOUR_SECRET_HERE"

# 定时任务配置
schedule:
  time: "17:00"  # 每日执行时间

# 数据更新配置
update:
  lookback_days: 10
  skip_failed: true
